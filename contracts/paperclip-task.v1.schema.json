{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andyfied-Thargoid/chess-commander/contracts/paperclip-task.v1.schema.json",
  "title": "Chess Commander Paperclip task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "parent_task_id",
    "idempotency_key",
    "title",
    "phase",
    "kind",
    "repository",
    "worker",
    "resources",
    "dependencies",
    "execution",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "review"
  ],
  "properties": {
    "schema": {"const": "chess-commander.paperclip-task.v1"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "parent_task_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{2,127}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 160},
    "phase": {"const": "phase1"},
    "kind": {"enum": ["install", "coding", "assessment", "evidence"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "base_branch", "work_branch", "allowed_paths"],
      "properties": {
        "owner": {"const": "andyfied-Thargoid"},
        "name": {"const": "chess-commander"},
        "base_branch": {"const": "main"},
        "work_branch": {"type": "string", "pattern": "^(codex|p40|copilot)/[a-z0-9][a-z0-9/-]{2,62}$"},
        "allowed_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "mode"],
      "properties": {
        "runtime": {"enum": ["p40", "copilot"]},
        "mode": {"const": "coder"},
        "account": {"type": ["string", "null"], "enum": ["andyfied-agent", "andyfied-Thargoid", null]},
        "fallback_for": {"type": ["string", "null"], "enum": ["p40", null]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "max_concurrency"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "max_concurrency": {"type": "integer", "const": 1}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "retry", "on_ambiguous"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "same_idempotency_key"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 0, "maximum": 3},
            "same_idempotency_key": {"const": true}
          }
        },
        "on_ambiguous": {"const": "reconcile_before_retry"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest", "source_images"],
      "properties": {
        "source_manifest": {"const": "SOURCE_MANIFEST.json"},
        "source_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["backend", "path", "sha256"],
            "properties": {
              "backend": {"enum": ["acornsoft", "thompson"]},
              "path": {"type": "string", "pattern": "^/mnt/scratch/project-data/chess-commander/[^/]+\\.ssd$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 8}, "minItems": 1},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "runtime", "mode", "fix_runtime", "max_fix_rounds", "failure_action"],
      "properties": {
        "required": {"const": true},
        "runtime": {"const": "codex"},
        "mode": {"const": "review"},
        "fix_runtime": {"enum": ["p40", "copilot"]},
        "max_fix_rounds": {"type": "integer", "minimum": 1, "maximum": 2},
        "failure_action": {"enum": ["return_to_p40", "return_to_copilot"]}
      }
    }
  }
}
