{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andyfied-Thargoid/chess-commander/contracts/paperclip-review.v1.schema.json",
  "title": "Chess Commander Codex review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "idempotency_key", "branch", "round", "decision", "checked", "findings", "requested_fixes", "evidence"],
  "properties": {
    "schema": {"const": "chess-commander.paperclip-review.v1"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{2,127}$"},
    "branch": {"type": "string", "pattern": "^(codex|p40|copilot)/[a-z0-9][a-z0-9/-]{2,62}$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "decision": {"enum": ["pass", "fix_required"]},
    "checked": {
      "type": "array",
      "items": {"enum": ["diff_scope", "tests", "source_boundary", "evidence"]},
      "minItems": 4,
      "uniqueItems": true
    },
    "findings": {"type": "array", "items": {"type": "string"}},
    "requested_fixes": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
